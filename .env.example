# Neon의 맛다공 커뮤니티 개발 DB 접속 설정
COMMUNITY_DB_URL=jdbc:postgresql://<Neon host>:5432/matdagong_community_dev?sslmode=require
COMMUNITY_DB_USERNAME=<community app role>
COMMUNITY_DB_PASSWORD=<community app role password>

# Neon 장소 DB는 초기 개발 설정에서 기존 개발 앱 계정을 재사용합니다.
PLACE_DB_URL=jdbc:postgresql://<Neon host>:5432/matdagong_place_dev?sslmode=require
PLACE_DB_USERNAME=<community app role>
PLACE_DB_PASSWORD=<community app role password>

# 서비스 간 직접 호출 주소. 로컬 기본값과 같으면 생략할 수 있습니다.
COMMUNITY_SERVICE_URL=http://localhost:5844
PLACE_SERVICE_URL=http://localhost:5845

# 장소 서비스가 가게 기본정보를 카카오 Local API로 확인할 때 쓰는 REST API 키(지도용 JavaScript 키와 다름).
# 비워 두면 검증하지 않고, 이미 등록된 가게 정보는 갱신하지 않습니다.
KAKAO_REST_API_KEY=<맛다공 카카오 앱의 REST API 키>

# 비공개 기록 사진의 서명 주소용 키(32자 이상 임의 문자열). 비워 두면 장소 서비스를 재시작할 때마다 바뀝니다.
PLACE_MEDIA_SIGNING_KEY=<임의의 긴 문자열>
